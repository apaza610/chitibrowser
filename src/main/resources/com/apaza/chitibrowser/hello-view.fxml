<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.web.WebView?>

<VBox alignment="CENTER" prefHeight="200.0" prefWidth="300.0" spacing="4.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.apaza.chitibrowser.HelloController">
    <padding>
        <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
    </padding>
   <HBox prefWidth="200.0" VBox.vgrow="NEVER">
      <children>
          <Button onAction="#cargarSitio" text="_go" HBox.hgrow="NEVER" />
         <TextField fx:id="tfPath" HBox.hgrow="ALWAYS" />
         <Button onAction="#resizeVentana" text="resi_ze">
            <font>
               <Font size="10.0" />
            </font>
         </Button>
      </children>
   </HBox>
   <WebView fx:id="wvNavegador" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
</VBox>
